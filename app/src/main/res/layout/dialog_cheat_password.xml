<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_network_item_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/cheatPasswordDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rcbold"
        android:text="Player Cheating Selection"
        android:textColor="#FFD700"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cheatPasswordDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/rcnormal"
        android:text="Enter password to unlock this settings section."
        android:textColor="#CCCCCC"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/cheatPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#1F1840"
        android:fontFamily="@font/rcbold"
        android:hint="Password"
        android:imeOptions="actionDone"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8888AA"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/cheatPasswordErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/rcnormal"
        android:text="Incorrect password. Please try again."
        android:textColor="#FF6B6B"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cheatPasswordCancelBtn"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/rcbold"
            android:text="Cancel"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <Button
            android:id="@+id/cheatPasswordUnlockBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#F5B201"
            android:fontFamily="@font/rcbold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Unlock"
            android:textColor="#101828"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
